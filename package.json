{
    "name": "@hlf-core/api",
    "version": "3.1.7",
    "description": "TypeScript library for Hyperledger Fabric connectivity: gateway client, qscc system contract, block parsing and connection settings",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@ts-core/common": "~3.0.7",
        "fabric-network": "2.2.16"
    },
    "devDependencies": {
        "gulp-npm-module-publisher": "~3.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/hlf-core-api.git"
    },
    "keywords": [
        "hyperledger",
        "hyperledger-fabric",
        "fabric",
        "blockchain",
        "distributed-ledger",
        "qscc",
        "block-parser",
        "gateway",
        "typescript"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/hlf-core-api/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/hlf-core-api#readme"
}
